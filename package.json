{
	"name": "model-ploof",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.20.0",
	"engines": {
		"node": "^26.12.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:ui": "node --env-file=.env tests/ui/run.ts",
		"drive": "node --env-file=.env scripts/drive.ts",
		"setup:tlc": "mkdir -p tools && curl -fsSL -o tools/tla2tools.jar https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar",
		"db:up": "docker compose up -d --wait",
		"db:reset": "node --env-file=.env scripts/db-reset.ts",
		"db:auth-schema": "node --env-file=.env scripts/generate-auth-schema.ts"
	},
	"devDependencies": {
		"@antithesishq/bombadil": "^0.7.10",
		"@eslint/js": "^10.0.1",
		"@mapbox/vector-tile": "^3.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"@types/pg": "^8.23.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fast-check": "^4.10.2",
		"globals": "^17.6.0",
		"pbf": "^5.1.2",
		"playwright-core": "^1.65.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"better-auth": "^1.7.22",
		"maplibre-gl": "^6.18.0",
		"pg": "^8.23.1",
		"svelte-maplibre-gl": "^2.2.1"
	}
}
